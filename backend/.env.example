# Alpha-Guard Environment Configuration
# ========================================
# Copy this file as .env and fill in the values.

# Google Gemini API Key
# Get your key from: https://aistudio.google.com/app/apikey
# Required for AI-powered forensic linguistic analysis.
# Without this key, the Truth Score is computed from hedging/evasion heuristics only.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model id. Change this if Google retires the default.
GEMINI_MODEL=gemini-2.5-flash

# SEC EDGAR requires a User-Agent naming you and a real contact email,
# or it may block requests: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name your.email@example.com"

# Comma-separated frontend origins allowed to call the API ("*" = any).
# Production example: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Forensic audits / PDF reports allowed per client IP per minute (0 = unlimited).
RATE_LIMIT_PER_MINUTE=10

# Truth Score mode:
#   demo     (default) simulated score, fixed per ticker; no Gemini calls. Labelled "DEMO" in the UI.
#   computed hedging/evasion/tone heuristics + Gemini red flags.
TRUTH_SCORE_MODE=demo
